{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charthouse.local/schemas/expedition.schema.json",
  "title": "Charthouse Expedition transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "created_at",
    "updated_at",
    "baseline",
    "draft_root",
    "surveys",
    "events"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^E-[0-9]{4,}$" },
    "status": {
      "enum": [
        "surveying",
        "ready-for-synthesis",
        "synthesizing",
        "awaiting-approval",
        "approved",
        "publishing",
        "published",
        "invalidated",
        "failed",
        "abandoned"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty",
        "canonical_ref",
        "canonical_commit",
        "config_digest",
        "map_generated_at"
      ],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" },
        "canonical_ref": { "type": "string" },
        "canonical_commit": { "type": ["string", "null"] },
        "config_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "map_generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "draft_root": { "type": "string" },
    "surveys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "capability", "documentation", "duplication"],
      "properties": {
        "structure": { "$ref": "#/$defs/survey" },
        "capability": { "$ref": "#/$defs/survey" },
        "documentation": { "$ref": "#/$defs/survey" },
        "duplication": { "$ref": "#/$defs/survey" }
      }
    },
    "synthesis": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/synthesis" }]
    },
    "publication": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publication" }]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "type"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "type": { "type": "string" },
          "role": { "enum": ["structure", "capability", "documentation", "duplication"] },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "plan_digest", "completed_at", "written", "removed"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "written": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "draft_path", "inputs", "staged", "approvals", "approved_digest"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "draft_path": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "config_digest", "map_digest", "reports"],
          "properties": {
            "commit": { "type": ["string", "null"] },
            "config_digest": { "$ref": "#/$defs/digest" },
            "map_digest": { "$ref": "#/$defs/digest" },
            "reports": {
              "type": "object",
              "additionalProperties": false,
              "required": ["structure", "capability", "documentation", "duplication"],
              "properties": {
                "structure": { "$ref": "#/$defs/digest" },
                "capability": { "$ref": "#/$defs/digest" },
                "documentation": { "$ref": "#/$defs/digest" },
                "duplication": { "$ref": "#/$defs/digest" }
              }
            }
          }
        },
        "staged": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "digest", "capabilities"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "digest": { "$ref": "#/$defs/digest" },
                "capabilities": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "digest", "at"],
            "properties": {
              "capability": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "approved_digest": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
        }
      }
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "status",
        "report_path",
        "report_digest",
        "validated_at",
        "attempts",
        "validation_errors"
      ],
      "properties": {
        "role": { "enum": ["structure", "capability", "documentation", "duplication"] },
        "status": { "enum": ["missing", "invalid", "valid"] },
        "report_path": { "type": "string" },
        "report_digest": { "type": ["string", "null"] },
        "validated_at": { "type": ["string", "null"], "format": "date-time" },
        "attempts": { "type": "integer", "minimum": 0 },
        "window": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["started_at", "head_commit", "signature", "proof"],
              "properties": {
                "started_at": { "type": "string", "format": "date-time" },
                "head_commit": { "type": ["string", "null"] },
                "signature": { "$ref": "#/$defs/digest" },
                "proof": { "$ref": "#/$defs/digest" }
              }
            }
          ]
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "type": "string" },
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
